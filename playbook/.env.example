# Stripe secret key — get it from https://dashboard.stripe.com/apikeys
# Use a TEST key (sk_test_...) while validating, then switch to a LIVE key (sk_live_...) to take real money.
STRIPE_SECRET_KEY=sk_test_xxx

# The Stripe Price ID for the one-time purchase (price_...).
# Created for you via the Stripe MCP, or create one in the dashboard.
STRIPE_PRICE_ID=price_xxx
